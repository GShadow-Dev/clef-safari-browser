# Local only. Copy to .env and fill these in; never commit your .env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# Both are Clef decision models; Flash minimizes input cost.
CLEF_MODEL=clef-flash
CLEF_DAILY_NEURONS=8000
CLEF_MAX_STEPS=24
CLEF_ESCALATE=true

# Optional; keep the same directory across clients to preserve accounting.
# CLEF_STATE_DIR=/absolute/path/to/private/state
# SAFARI_DRIVER=/usr/bin/safaridriver
